/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio-website-public",
	"main": "workers/app.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"ai": {
		"binding": "AI"
	},
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CV_STORE",
			"id": "aeca3ad094a84aba95e3500f274ef1a8",
			"preview_id": "6f5a1c3455af4104acd0edcba16cd67e"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "portfolio-studio",
			"database_id": "7968fa0c-6407-4d83-9187-2dd6c8a3d0ff",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		// Weekly Monday 09:00 UTC - CV / projects freshness reminders
		"crons": ["0 9 * * 1"]
	},
	"vars": {
		"STUDIO_REMINDER_TO": "hey@alexandreboissel.me",
		"STUDIO_REMINDER_FROM": "studio@alexandreboissel.me"
	},
	"routes": [
		{
			"pattern": "alexandreboissel.me",
			"zone_name": "alexandreboissel.me",
			"custom_domain": true
		}
	]
}
